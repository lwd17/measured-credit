# Copy to .env, edit, then `source .env`.

# Base model served by the sampler and fine-tuned with LoRA.
export SSC_MODEL=$HOME/models/Qwen3-4B

# ALFWorld data (output of `alfworld-download -f`).
export ALFWORLD_DATA=$HOME/.cache/alfworld

# WebShop checkout, so that its package is importable.
export WEBSHOP_PATH=$HOME/webshop

# Search-R1 parquet files for the multi-hop QA setting.
export SEARCHR1_DIR=$PWD/data/searchr1

# Retrieval service for the multi-hop QA setting; must serve POST /search and
# POST /browse. Passed to multihop/train.py as --wiki_url.
export WIKI_URL=http://127.0.0.1:8080
